// Doggy.market sniper schema.
// Prices are stored in shibes (1 DOGE = 100,000,000 shibes) to avoid float drift.

generator client {
  provider      = "prisma-client-js"
  // Compile engines for both local dev and Linux container deploys.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Watch {
  id              String   @id @default(cuid())
  slug            String   @unique // e.g. "doginal-primes"
  maxPriceShibes  BigInt
  enabled         Boolean  @default(true)
  autoBuy         Boolean  @default(false) // when true + Settings.dryRun=false, executor fires
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hits            Hit[]
}

model Hit {
  id                 String   @id @default(cuid())
  watchId            String
  watch              Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  inscriptionId      String
  inscriptionNumber  Int?
  priceShibes        BigInt
  sellerAddress      String
  listedAt           DateTime
  detectedAt         DateTime @default(now())
  // Lifecycle: DETECTED -> NOTIFIED -> (BUYING -> BOUGHT | FAILED | SKIPPED)
  status             String   @default("DETECTED")
  txId               String?
  notes              String?

  @@unique([watchId, inscriptionId])
  @@index([detectedAt])
}

// Singleton config row (id="default"). Keeps us out of process.env for runtime knobs.
model Settings {
  id              String  @id @default("default")
  dryRun          Boolean @default(true)        // log only; never submit
  dailyCapShibes  BigInt  @default(0)           // 0 = unlimited
  updatedAt       DateTime @updatedAt
}

// Encrypted Dogecoin private key. There is at most one row.
model WalletKey {
  id           String   @id @default("default")
  address      String   // derived P2PKH address (Dogecoin: D...)
  // AES-256-GCM(scrypt(passphrase)) over the raw 32-byte privkey.
  cipher       String   // base64
  iv           String   // base64
  salt         String   // base64
  createdAt    DateTime @default(now())
}
