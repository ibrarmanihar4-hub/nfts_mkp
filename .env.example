# SQLite by default; swap for postgres URL in production.
DATABASE_URL="file:./dev.db"

# How often to hit doggy.market's listings API per collection (ms).
# Lower = faster sniping but more API calls.
# 1000ms = snipe within ~1-2s of listing appearing (aggressive)
# 2000ms = snipe within ~2-3s (recommended)
# 500ms  = maximum speed but may get rate-limited
POLL_INTERVAL_MS=1000

# Optional: Telegram alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: shared secret to call /api/poll (used by external cron). Leave blank to disable auth.
POLL_SECRET=
